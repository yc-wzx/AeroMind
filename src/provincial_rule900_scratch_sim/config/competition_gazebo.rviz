      Name: Robot Marker
      Namespaces:
        planar_simulation_robot: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground/simulation/robot
