    - Alpha: 1
      Axes Length: 0.550000011920929
      Axes Radius: 0.05000000074505806
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.30000001192092896
      Head Radius: 0.10000000149011612
      Name: Commanded Setpoint
      Shaft Length: 1
      Shaft Radius: 0.05000000074505806
      Shape: Axes
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground/planning/commanded_setpoint
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Competition Field
      Namespaces:
        competition_collision_boundary: true
        competition_course: true
        competition_floor: true
        competition_labels: true
        competition_reference_route: true
        competition_zones: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground/simulation/field
